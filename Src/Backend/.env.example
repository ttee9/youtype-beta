OPENAI_API_KEY=sk-your-actual-key-here
DATABASE_URL=postgresql://user:password@host:5432/dbname
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.vercel.app

# Shared secret for the /admin/* dev-tooling routes (toggle a post's
# active/blocked status without voting). Leave unset to disable them.
ADMIN_TOKEN=

# Reverse proxies in front of the API that append to X-Forwarded-For.
# 1 for a single PaaS edge (Railway/Render); raise it if you add e.g. a CDN.
TRUSTED_PROXY_HOPS=1
